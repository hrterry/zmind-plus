  "buildCommand": "VITE_ZMIND_DEMO_ONLY=true npm run build --workspace=@zmind-plus/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
