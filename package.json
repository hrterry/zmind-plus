{
  "name": "zmind-plus",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first visual interface for supervising agent research.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@zmind-plus/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
