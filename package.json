{
  "name": "zmind-plus",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first visual interface for supervising agent research.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark:graph": "npm run benchmark:graph --workspace=@zmind-plus/core",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently --kill-others --names runtime,web --prefix-colors blue,magenta \"npm run dev --workspace=@zmind-plus/runtime\" \"npm run dev --workspace=@zmind-plus/web\"",
    "dev:runtime": "npm run dev --workspace=@zmind-plus/runtime",
    "dev:web": "npm run dev --workspace=@zmind-plus/web",
    "seed:demo": "npm run seed:demo --workspace=@zmind-plus/runtime",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
