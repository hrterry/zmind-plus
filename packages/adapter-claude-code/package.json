{
  "name": "@zmind-plus/adapter-claude-code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-safe Claude Code lifecycle adapter for Zmind+.",
  "license": "MIT",
  "bin": {
    "zmind-claude-hook": "dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@zmind-plus/core": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
